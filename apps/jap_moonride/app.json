{
  "id": "jap_moonride",
  "title": "Moonride",
  "description": "Moonride: Moonlight game streaming from your PC (Sunshine / Apollo / Vibepollo) on the whole screen, parked only by default. Pairing, app list, Start / Stop; the stream is decoded by the mgu-moonlight tool and drawn by mgu-render",
  "version": "0.3.4",
  "vendor": "custom",
  "license": "GPL-3.0-or-later",
  "loggingId": "MOON",
  "iconGlyph": "MR",
  "permissions": [
    {"domain": "VIN-*", "interfaceName": "de/bmw/infotainment/telematic/oap/appruntime/AppRuntime_ff", "operation": "stopApp"}
  ],
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infotainment.controlelements.FrontCCU": {
      "statusRotaryEncoderState": "rs",
      "ccsControlTouchCCU": "w"
    },
    "de.bmw.infotainment.ControllerElements": {
      "ZBETouchFrontSide": "rs"
    },
    "org.genivi.am.commandinterface.CommandControl": {
      "_instances": "1",
      "_methods": ["connect", "disconnect", "getListMainConnections"]
    },
    "org.genivi.am.routinginterface.RoutingControlObserver": {
      "_instances": "1",
      "_methods": ["hookSourceAvailablityStatusChange"]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Moonride",
      "hmi": false,
      "fill": true,
      "buttons": [
        ["BTN_NEXT", "Next"],
        ["BTN_OK", "Open"],
        ["BTN_PADS", "Gamepads"],
        ["BTN_SETTINGS", "Settings"]
      ]
    },
    {
      "name": "GAME",
      "kind": "canvas",
      "title": "Moonride",
      "chrome": false
    }
  ],
  "settings": [
    {
      "key": "resume",
      "label": "Resume the game after a lost connection or a switch to another app (the game stays open on the PC; Back or Quit ends it)",
      "type": "bool",
      "default": true
    },
    {
      "key": "parkedOnly",
      "label": "Parked only (stops the stream when the car moves; cannot be turned off while moving). Off = streaming while driving, AT YOUR OWN RISK: passengers only, the driver must never watch or play",
      "type": "bool",
      "default": true
    },
    {
      "key": "stats",
      "label": "Performance statistics (over the game; in a game: hold the controller pressed for 3 s)",
      "type": "bool",
      "default": false
    },
    {
      "key": "res",
      "label": "Resolution",
      "type": "choice",
      "default": "1920x720",
      "options": [
        [
          "1920x720",
          "1920 x 720 (whole screen)"
        ],
        [
          "1280x720",
          "1280 x 720 (pillarboxed)"
        ]
      ]
